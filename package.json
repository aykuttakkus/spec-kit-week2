{
  "name": "quote-of-the-day",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"*.{html,css,js,json,md}\" \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"*.{html,css,js,json,md}\" \"src/**/*.js\" \"tests/**/*.js\"",
    "lint": "eslint .",
    "serve": "node tests/static-server.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm run format:check && npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
